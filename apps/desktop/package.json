{
  "name": "@sovereign/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign desktop shell (Electron). Loads the @sovereign/web build.",
  "author": "CodeByBryant",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "pnpm --filter @sovereign/web build && pnpm build && electron .",
    "package": "pnpm --filter @sovereign/web build && pnpm build && electron-builder"
  },
  "devDependencies": {
    "@sovereign/web": "workspace:*",
    "@types/node": "^22.10.0",
    "electron": "^42.11.16",
    "electron-builder": "^24.9.1"
  },
  "main": "dist/main.js"
}
