{
  "name": "@sovereign/simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:determinism": "vitest run --config vitest.determinism.config.ts",
    "probe": "vitest run --config vitest.probe.config.ts"
  },
  "dependencies": {
    "@sovereign/config": "workspace:*",
    "@sovereign/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
