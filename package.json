{
  "name": "sovereign",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Sovereign - a procedural, deterministic geopolitical simulation.",
  "license": "MIT",
  "author": "CodeByBryant",
  "homepage": "https://codebybryant.github.io/Sovereign/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeByBryant/Sovereign.git"
  },
  "bugs": {
    "url": "https://github.com/CodeByBryant/Sovereign/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sovereign/web dev",
    "desktop": "pnpm --filter @sovereign/desktop start",
    "sim": "pnpm --filter @sovereign/simulator-cli start --",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^1.6.1"
  }
}
