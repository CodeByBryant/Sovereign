{
  "name": "sovereign",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Sovereign - a procedural, deterministic geopolitical simulation.",
  "license": "MIT",
  "author": "CodeByBryant",
  "homepage": "https://codebybryant.github.io/Sovereign/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeByBryant/Sovereign.git"
  },
  "bugs": {
    "url": "https://github.com/CodeByBryant/Sovereign/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sovereign/web dev",
    "desktop": "pnpm --filter @sovereign/desktop start",
    "sim": "pnpm --filter @sovereign/simulator-cli start --",
    "build": "pnpm -r build",
    "test": "pnpm test:tools && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:deps && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lint:deps": "node tools/check-dependency-rules.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "test:determinism": "pnpm --filter @sovereign/simulation test:determinism",
    "probe": "pnpm --filter @sovereign/simulation probe"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
